# Web3Forms access key. This is public by design — it's an alias for a
# delivery email address, not a secret — so it ships in the client bundle.
# Get one at https://web3forms.com and put the real value in .env.local
# (gitignored). The build fails with a clear error if this is unset.
NEXT_PUBLIC_WEB3FORMS_KEY=your-web3forms-access-key

# The origin this deployment is published at, with protocol and no
# trailing slash. It is what canonical URLs, Open Graph URLs, the sitemap
# and the JSON-LD are resolved against, so set it on the production
# deployment once the domain is decided.
#
# Leave it unset on previews: the build falls back to the Vercel
# deployment URL, so a preview describes itself instead of claiming to be
# the live site. Unset and off Vercel it falls back to localhost.
NEXT_PUBLIC_SITE_URL=https://campmeeting.newlifesdanairobi.org
